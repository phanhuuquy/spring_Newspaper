@using UC.LADI.MAG.WEB.Common

@{
    ViewData["Title"] = "Chào Xuân Ất Tỵ";
    Layout = "~/Pages/Shared/_LayoutPublish.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@ConstLocation.value/css/events/spring/style.css" />
}

<main class="size-full flex justify-center">
    <div class="container max-w-screen-2xl self-center">
        <div class="bg-cover bg-no-repeat"
             style="background-image: url('@ConstLocation.value/img/events/spring/linear_top_background.svg');">
            <div class="nav_bar gap-2 sm:gap-0 flex p-2 sm:py-3 sm:px-5 md:py-5 md:px-20 items-center">
                <label class="text-white text-center text-xs sm:text-sm md:text-base line-clamp-1">
                    SỞ VĂN HÓA, THỂ THAO VÀ DU LỊCH PHÚ YÊN
                </label>
                <nav class="grow flex items-end">
                    <ul class="flex space-x-1 sm:space-x-3 md:space-x-6 ml-auto items-center">
                        <li>
                            <a id="btn-spring-newspaper"
                               class="text-white hover:opacity-60 duration-300 cursor-pointer text-xs sm:text-sm md:text-base">
                                Báo xuân
                            </a>
                        </li>
                        <li>
                            <a id="btn-event-image"
                               class="text-white hover:opacity-60 duration-300 cursor-pointer text-xs sm:text-sm md:text-base">
                                Hình ảnh sự kiện
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="flex flex-col gap-2 md:flex-row items-center justify-between w-full h-auto pt-6 pb-16 sm:pt-12 sm:pb-16 sm:py-20 md:pt-16 md:pb-20 sm:py-3 p-2 sm:px-5 md:px-20">
                <div class="flex flex-col gap-4 sm:gap-6 md:gap-10 md:max-w-[47%]">
                    <div id="event-name" class="font-['PiklabSuperFoods'] text-[#FBEAB6] text-3xl sm:text-4xl md:text-5xl leading-tight sm:leading-snug md:leading-normal text-center"
                         style="text-shadow: 0px 4px 4px rgba(0,0,0,0.25);">
                        Đang tải...
                    </div>
                    <div id="event-year" class="font-['PiklabSuperFoods'] text-[#FBEAB6] text-6xl sm:text-7xl md:text-8xl text-center"
                         style="text-shadow: 0px 4px 4px rgba(0,0,0,0.25); line-height: 1 !important;">
                        ...
                    </div>
                    <div id="event-description" class="font-['PiklabSuperFoods'] text-[#FBEAB6] text-base sm:text-lg md:text-xl text-center"
                         style="text-shadow: 0px 4px 4px rgba(0,0,0,0.25);">
                        Đang tải...
                    </div>
                </div>
                <img id="event-avatar" class="top-background-right aspect-[758/487] md:max-w-[47%]" alt="Đón Xuân 2025"
                     src="@ConstLocation.value/img/loading.png" />
            </div>
        </div>
        <div class="bg-cover bg-no-repeat mt-[-65px] flex flex-col p-2 sm:px-5 md:px-20"
             style="background-image: url('@ConstLocation.value/img/events/spring/linear_middle_background.svg');">
            @* <img src="@ConstLocation.value/img/events/spring/Báo_Xuân_Ất_Tỵ_2025.svg" alt="Báo Xuân Ất Tỵ 2025"
            class="middle_background_title aspect-[724/72] mt-28" /> *@
            <div id="bib-container"
                 class="font-['PiklabSuperFoods'] text-white text-2xl sm:text-3xl md:text-4xl leading-tight sm:leading-snug md:leading-normal text-center mt-28"
                 style="text-shadow: 0px 10px 8.3px rgba(253,53,54,0.25);">
                BÁO XUÂN ẤT TỴ 2025
            </div>
            <nav class="event-nav mt-8">
                <ul id="collection-nav" class="flex flex-wrap gap-4 justify-center">
                    <!-- Thẻ "Tất cả" mặc định -->
                    <li class="collection-item active py-2 px-4 bg-red-500 text-white rounded cursor-pointer" data-id="all">
                        <img src="@ConstLocation.value/img/events/spring/coin.svg" alt="Xu" class="inline-block w-6 h-6 mr-2" />
                        Tất cả
                    </li>
                </ul>
            </nav>
            <div id="item-container" class="grid grid-cols-5 gap-4 mt-8">

                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
                <div class="item-slot aspect-[220/314] bg-gray-100 rounded shadow hidden"></div>
            </div>


            <div id="item-detail-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50">
                <div class="bg-white rounded-lg p-6 w-11/12 md:w-2/3 lg:w-1/2">
                    <div class="flex items-start">
                        <div class="image-container w-1/3">
                            <img id="item-detail-avatar" src="" alt="Bìa sách" class="w-full rounded">
                        </div>

                        <div class="content w-2/3 ml-6">
                            <h1 id="item-detail-title" class="text-2xl font-bold mb-4"></h1>
                            <p id="item-detail-tenant" class="text-gray-600 mb-2"></p>
                            <p id="item-detail-description" class="text-gray-700 mb-4"></p>
                            <a id="item-detail-path" href="" target="_blank" class="bg-blue-500 text-white px-4 py-2 rounded hidden">
                                Đọc Báo
                            </a>
                        </div>
                    </div>
                    <button id="close-item-detail" class="mt-6 bg-red-500 text-white px-4 py-2 rounded">
                        Đóng
                    </button>
                </div>
            </div>


            <div id="magazine-container"
                 class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2 sm:gap-4 md:gap-6 self-center mt-3 sm:mt-8 md:mt-10 pb-4 sm:pb-6 md:pb-8">
            </div>
        </div>
        <div class="w-full bg-cover bg-no-repeat relative mt-[-1px] pt-28 sm:pt-40 p-2 sm:px-5 md:px-20"
             style="background-image: url('@ConstLocation.value/img/events/spring/linear_bottom_background.svg');">
            <div id="event-image-container"
                 class="flex flex-col md:flex-row grow justify-between items-center pb-10 gap-2 md:gap-4">
                <div class="flex flex-col items-center gap-2 sm:gap-4 md:max-w-[45%]">
                    <img src="@ConstLocation.value/img/events/spring/bottom_background_title.svg" alt="Hình ảnh sự kiện"
                         class="bottom_background_title aspect-[511/72]" /> 

                    <img src="@ConstLocation.value/img/events/spring/bottom_background_share_button.svg" alt="Chia sẻ"
                         class="hidden sm:block hover:opacity-60 duration-300 cursor-pointer" />
                </div>
                @* <img src="@ConstLocation.value/img/events/spring/bottom_background_grid_image.png"
                alt="Hình ảnh sự kiện" class="grid_image aspect-[645/575] md:max-w-[45%]" /> *@
                <div class="grid_image aspect-square md:max-w-[40%] grid grid-cols-2 place-items-stretch gap-1 p-1 sm:p-2"></div>
                <img src="@ConstLocation.value/img/events/spring/bottom_background_share_button.svg" alt="Chia sẻ"
                     class="block sm:hidden hover:opacity-60 duration-300 cursor-pointer" />
            </div>
            <img src="@ConstLocation.value/img/events/spring/bottom_background_left_couplet.svg"
                 class="left_couplet absolute left-1 bottom-0 md:bottom-1" />
            <img src="@ConstLocation.value/img/events/spring/bottom_background_right_couplet.svg"
                 class="right_couplet absolute right-0 bottom-1 md:bottom-3" />
        </div>
    </div>
</main>

@section scripts {
    <script>
        async function loadEvent() {
            try {
                const response = await fetch('/api/public/event/list');
                if (!response.ok) {
                    console.error("Failed to fetch event data");
                    return;
                }

                const events = await response.json();
                if (events && events.length > 0) {
                    const event = events[0]; 

                    document.getElementById('event-name').innerText = event.name || "Không có tên sự kiện";
                    document.getElementById('event-year').innerText = event.year || "N/A";
                    document.getElementById('event-description').innerText = event.description || "Không có mô tả sự kiện";
                    document.getElementById('event-avatar').src = event.avatar || "@ConstLocation.value/img/default-avatar.png";
                } else {
                    console.warn("No events found in the response.");
                }
            } catch (error) {
                console.error("Error fetching event data:", error);
            }
        }

        loadEvent();


        // trang item , bst

        document.addEventListener("DOMContentLoaded", function () {
            const apiEndpoints = {
                topItems: "/api/public/item/top-item",
                allCollections: "/api/public/collection/all",
                collectionItems: "/api/public/collection/{id_collection}/items",
                itemDetails: "/api/public/item/{item_id}"
            };

            const collectionNav = document.getElementById("collection-nav");
            const itemContainer = document.getElementById("item-container");
            const modal = document.getElementById("item-detail-modal");


            const detailTitle = document.getElementById("item-detail-title");
            const detailAvatar = document.getElementById("item-detail-avatar");
            const detailDescription = document.getElementById("item-detail-description");
            const detailPath = document.getElementById("item-detail-path");
            const closeDetailButton = document.getElementById("close-item-detail");

           
            async function fetchData(url) {
                try {
                    const response = await fetch(url);
                    if (!response.ok) throw new Error("Network response was not ok");
                    return await response.json();
                } catch (error) {
                    console.error("Fetch error: ", error);
                }
            }

            async function renderItems(apiUrl) {
                try {
                    const data = await fetchData(apiUrl);
                    const slots = document.querySelectorAll(".item-slot");

                    
                    slots.forEach(slot => {
                        slot.classList.add("hidden");
                        slot.innerHTML = "";
                    });

                  
                    const items = Array.isArray(data) ? data :
                        (data.items ? data.items : []);

                    if (items && items.length > 0) {
                      
                        items.forEach((item, index) => {
                            if (index < slots.length) {
                                const slot = slots[index];
                                slot.classList.remove("hidden");
                                slot.innerHTML = `
                                <img src="${item.avatar}" alt="${item.title}" class="w-full h-full object-cover rounded cursor-pointer">
                                <button class="hidden item-id" data-id="${item.id}"></button>
                            `;

                           
                                slot.querySelector("img").addEventListener("click", function () {
                                    openDetailForm(item.id);
                                });
                            }
                        });
                    }
                } catch (error) {
                    console.error("Lỗi render items:", error);
                }
            }

            async function openDetailForm(itemId) {
                try {
                    const url = `/api/public/item/${itemId}`;
                    const item = await fetchData(url);
                    const modal = document.getElementById("item-detail-modal");

                    if (item) {
                        document.getElementById("item-detail-title").textContent = item.title;
                        document.getElementById("item-detail-avatar").src = item.avatar;
                        document.getElementById("item-detail-tenant").textContent = `Tác Giả: ${item.tenant}`;
                        document.getElementById("item-detail-description").textContent = `Mô tả: ${item.description}`;

                        const readLink = document.getElementById("item-detail-path");
                        if (item.path) {
                            readLink.href = item.path;
                            readLink.classList.remove("hidden");
                        } else {
                            readLink.href = ""; 
                            readLink.classList.add("hidden");
                        }

                        modal.classList.remove("hidden");
                    } else {
                        console.error("Không tìm thấy item với ID:", itemId);
                       
                        alert("Không tìm thấy thông tin sách!");

                    }
                } catch (error) {
                    console.error("Lỗi khi lấy dữ liệu item:", error);
              
                    alert("Đã có lỗi xảy ra khi lấy thông tin sách. Vui lòng thử lại sau!");
                }
            }

 
            document.getElementById("close-item-detail").addEventListener("click", function () {
                document.getElementById("item-detail-modal").classList.add("hidden");
            });

            async function renderCollections() {
                try {
                    const data = await fetchData(apiEndpoints.allCollections);
                    const collectionNav = document.getElementById("collection-nav");

                    if (data && data.length > 0) {
          
                        data.forEach(collection => {
                            const collectionHtml = `
                        <li class="collection-item py-2 px-4 bg-white text-red-500 rounded cursor-pointer border border-red-500"
                            data-id="${collection.id}">
                            ${collection.name}
                        </li>`;
                            collectionNav.insertAdjacentHTML("beforeend", collectionHtml);
                        });

              
                        document.querySelectorAll(".collection-item").forEach(item => {
                            item.addEventListener("click", async function () {
                    
                                document.querySelectorAll(".collection-item").forEach(el => {
                                    el.classList.remove("bg-red-500", "text-white");
                                    el.classList.add("bg-white", "text-red-500");
                                });

                    
                                this.classList.remove("bg-white", "text-red-500");
                                this.classList.add("bg-red-500", "text-white");

                                const collectionId = this.dataset.id;

                            
                                if (collectionId === "all") {
                                    await renderItems(apiEndpoints.topItems);
                                } else {
                                    const url = apiEndpoints.collectionItems.replace("{id_collection}", collectionId);
                                    await renderItems(url);
                                }
                            });
                        });
                    }
                } catch (error) {
                    console.error("Lỗi render collections:", error);
                }
            }
            renderCollections();
            renderItems(apiEndpoints.topItems);
        });


        async function loadTopHotImages() {
            try {
         
                const response = await fetch('/api/public/image/top-hot');
                if (!response.ok) {
                    console.error('lấy hình ảnh thất bại');
                    return;
                }

                const images = await response.json();

                const gridContainer = document.querySelector('.grid_image');
                gridContainer.innerHTML = ''; 

              
                images.forEach(image => {
                    const img = document.createElement('img');
                    img.src = image.path || "@ConstLocation.value/img/default-image.png";
                    img.alt = image.name || "Hình ảnh sự kiện";
                    img.className = "hover:opacity-80 duration-300 cursor-pointer"; 

                    gridContainer.appendChild(img);
                });
            } catch (error) {
                console.error('lỗi khi lấy hình ảnh:', error);
            }
        }

        loadTopHotImages();

        $('#btn-spring-newspaper').on('click', function (e) {
            e.preventDefault();
            $('html, body').animate({
                scrollTop: $('#bib-container').offset().top
            }, 600);
        });

        $('#btn-event-image').on('click', function (e) {
            e.preventDefault();
            $('html, body').animate({
                scrollTop: $('#event-image-container').offset().top
            }, 600);
        });
    </script>
    
}